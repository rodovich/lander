#!/usr/bin/env node
// lander — the CLI an in-task agent uses to call back into the lander server
// (launch/list/send/…), plus the hook handlers the server wires into claude
// (bash-guard, record-cwd, record/clear-worktree). Run execution now lives in the
// host daemon (daemon/index.ts), not here.
// Identity is injected when the server runs a turn: LANDER_API, LANDER_PROJECT,
// LANDER_TASK, and LANDER_TOKEN (the per-task secret that authenticates these
// callbacks).
import { spawnSync } from 'node:child_process'
import { pathToFileURL } from 'node:url'
import { inDateRange, matchesText, taskMetadata } from './task-metadata.js'

const {
  LANDER_API: API,
  LANDER_PROJECT: PROJECT,
  LANDER_TASK: TASK,
  LANDER_TOKEN: TOKEN,
} = process.env

const die = (m) => {
  console.error(`lander: ${m}`)
  process.exit(1)
}

async function call(project, path, init) {
  if (!API) die('not inside a lander task (LANDER_API unset)')
  // Identify the calling task so the server can authenticate it (e.g. to cap
  // the permissions a spawned task may be granted to this task's own). Sent on
  // every call; only permission-sensitive endpoints consult it.
  const auth = {}
  if (TASK) auth['x-lander-task'] = TASK
  if (PROJECT) auth['x-lander-project'] = PROJECT
  if (TOKEN) auth['x-lander-token'] = TOKEN
  const res = await fetch(`${API}/api/${project}${path}`, {
    ...init,
    headers: { 'content-type': 'application/json', ...auth, ...init?.headers },
  })
  const body = await res.json().catch(() => ({}))
  if (!res.ok) die(body.error || `${res.status} ${res.statusText}`)
  return body
}

async function setStatus(status, { quiet = false } = {}) {
  if (!TASK) die('no current task (LANDER_TASK unset)')
  await call(PROJECT, `/tasks/${TASK}`, {
    method: 'PATCH',
    body: JSON.stringify({ status }),
  })
  // `land` stays silent on success. It's terminal, so a "status → landed"
  // confirmation does nothing but invite the agent to echo it back — the
  // trailing "Landed." we're trying to kill. Nothing to react to, nothing to
  // say. Failures still surface via die(); wedge keeps its line since the
  // agent works on past it.
  if (!quiet) console.log(`status → ${status}`)
}

async function readStdin() {
  const chunks = []
  for await (const c of process.stdin) chunks.push(c)
  return Buffer.concat(chunks).toString('utf8')
}

// --date (a date/time the server parses) and --time (minutes from now) both set
// a wakeup time; they're mutually exclusive, and --time must be a positive
// number. Shared by `launch` (where a wakeup is optional), `rest`, and `send`.
// --await (a wakeup *condition* — other tasks landing) is orthogonal and may
// combine with either, so it isn't checked here; see resolveAwait.
function validateSchedule(o) {
  if (o.date != null && o.time != null)
    die('--date and --time are mutually exclusive')
  if (o.time != null && !(Number.isFinite(o.time) && o.time > 0))
    die('--time expects a positive number of minutes')
}

// Resolve a comma-separated --await value (task ids or unambiguous prefixes) to
// full ids, so the server stores canonical ids. `self` rejects a task awaiting
// itself (a deadlock). Returns the resolved ids, or undefined when no --await.
async function resolveAwait(value, { self } = {}) {
  if (value == null) return undefined
  const parts = value
    .split(',')
    .map((s) => s.trim())
    .filter(Boolean)
  if (!parts.length) die('--await expects one or more task ids')
  const ids = []
  for (const p of parts) {
    const id = await resolveId(p)
    if (self && id === self) die('a task cannot await itself')
    ids.push(id)
  }
  return ids
}

async function launchTask(rest) {
  const o = { project: PROJECT, allowEdits: false, allowCommits: false }
  const pos = []
  for (let i = 0; i < rest.length; i++) {
    const a = rest[i]
    if (a === '--project') o.project = rest[++i]
    else if (a === '--message') o.message = rest[++i]
    else if (a === '--title') o.title = rest[++i]
    else if (a === '--date') o.date = rest[++i]
    else if (a === '--time') o.time = Number(rest[++i])
    else if (a === '--await') o.await = rest[++i]
    else if (a === '--edits') o.allowEdits = true
    else if (a === '--commits') o.allowCommits = true
    else pos.push(a)
  }
  // The server caps the requested --edits/--commits to what this (spawning)
  // task holds, authenticating us by the caller headers `call` attaches; a task
  // can't grant a child access it lacks.
  o.message ??= pos.shift()
  if (o.message === '-') o.message = await readStdin()
  if (!o.message?.trim()) die('usage: lander launch <message>')
  validateSchedule(o)
  // --await defers the launch until the named tasks land (resolved to full ids
  // here); combinable with --date/--time, in which case launch fires on
  // whichever trigger comes first.
  o.await = await resolveAwait(o.await)
  // --title sets the name directly; without it the server asks haiku. --date or
  // --time defers the launch (a date/time the server parses, or N minutes from
  // now) and the server runs the task then.
  const task = await call(o.project, '/tasks', {
    method: 'POST',
    body: JSON.stringify(o),
  })
  console.log(task.id) // print new task id for the orchestrator to track
}

// Put the current task to rest with a scheduled wakeup. Takes the same
// --date/--time flags as `launch`, but one is required (a wakeup needs a time).
// The server flips the task to resting, records a `scheduled` event, and wakes
// it at that time with a generated "Resumed at …" message.
//
// --clear is the inverse: it drops a pending wakeup the task no longer needs —
// e.g. when the user woke it early (a reply leaves the trigger armed, so it would
// otherwise fire a spurious resume later). It takes no trigger of its own, leaves
// the task running, and is idempotent (nothing armed → "nothing to clear").
async function restTask(args) {
  if (!TASK) die('no current task (LANDER_TASK unset)')
  const o = {}
  for (let i = 0; i < args.length; i++) {
    const a = args[i]
    if (a === '--date') o.date = args[++i]
    else if (a === '--time') o.time = Number(args[++i])
    else if (a === '--await') o.await = args[++i]
    else if (a === '--clear') o.clear = true
    else die(`rest: unexpected argument ${a}`)
  }
  if (o.clear) {
    if (o.date != null || o.time != null || o.await != null)
      die('rest --clear takes no trigger (--date/--time/--await)')
    const res = await call(PROJECT, `/tasks/${TASK}/rest`, {
      method: 'POST',
      body: JSON.stringify({ clear: true }),
    })
    console.log(res.cleared ? 'wakeup cleared' : 'nothing to clear')
    return
  }
  if (o.date == null && o.time == null && o.await == null)
    die(
      'usage: lander rest (--date <when> | --time <minutes> | --await <ids> | --clear)',
    )
  validateSchedule(o)
  o.await = await resolveAwait(o.await, { self: TASK })
  await call(PROJECT, `/tasks/${TASK}/rest`, {
    method: 'POST',
    body: JSON.stringify(o),
  })
  console.log('resting')
}

// --interval (minutes) makes a relaunch repeat: each occurrence arms the next one
// that many minutes later, off its actual delivery time (no drift compensation).
// It pairs with the trigger flags — the first occurrence fires now (or at
// --date/--time/--await), and the cadence follows. --repeat-count N (total
// relaunches, including the first) or --repeat-until <when> bounds the series;
// they need --interval and are mutually exclusive with each other. Shared by
// `relaunch` and its flow method.
function validateRepeat(o) {
  if (o.interval == null) {
    if (o.repeatCount != null || o.repeatUntil != null)
      die('--repeat-count/--repeat-until require --interval')
    return
  }
  if (!(Number.isFinite(o.interval) && o.interval > 0))
    die('--interval expects a positive number of minutes')
  if (o.repeatCount != null && o.repeatUntil != null)
    die('--repeat-count and --repeat-until are mutually exclusive')
  if (o.repeatCount != null && !(Number.isInteger(o.repeatCount) && o.repeatCount >= 1))
    die('--repeat-count expects a positive integer')
  // --repeat-until parseability is left to the server (same leniency as --date).
}

// Relaunch the current task under a fresh provider session, keeping the
// same task id. Takes the same trigger flags as `launch` (--date/--time/--await)
// plus a positional message (or `-` for stdin); operates on the current TASK env
// like `rest`, with no target id. Without a trigger the seal happens now and the
// in-flight turn drains the message into the new session; with one it's deferred,
// and the old session stays live until the trigger fires.
//
// --interval <minutes> makes it repeat, bounded by --repeat-count/--repeat-until
// (see validateRepeat). --clear drops a pending scheduled relaunch — including a
// repeating one's armed next occurrence — (the inverse, like `rest --clear`),
// taking no trigger of its own; idempotent.
async function relaunchTask(args) {
  if (!TASK) die('no current task (LANDER_TASK unset)')
  const o = {}
  const pos = []
  for (let i = 0; i < args.length; i++) {
    const a = args[i]
    if (a === '--date') o.date = args[++i]
    else if (a === '--time') o.time = Number(args[++i])
    else if (a === '--await') o.await = args[++i]
    else if (a === '--interval') o.interval = Number(args[++i])
    else if (a === '--repeat-count') o.repeatCount = Number(args[++i])
    else if (a === '--repeat-until') o.repeatUntil = args[++i]
    else if (a === '--clear') o.clear = true
    else pos.push(a)
  }
  if (o.clear) {
    if (
      o.date != null ||
      o.time != null ||
      o.await != null ||
      o.interval != null ||
      o.repeatCount != null ||
      o.repeatUntil != null
    )
      die('relaunch --clear takes no trigger (--date/--time/--await/--interval)')
    const res = await call(PROJECT, `/tasks/${TASK}/relaunch`, {
      method: 'POST',
      body: JSON.stringify({ clear: true }),
    })
    console.log(res.cleared ? 'scheduled relaunch cleared' : 'nothing to clear')
    return
  }
  let message = pos.shift()
  if (message === '-') message = await readStdin()
  if (!message?.trim()) die('usage: lander relaunch <message>')
  validateSchedule(o)
  validateRepeat(o)
  o.await = await resolveAwait(o.await, { self: TASK })
  await call(PROJECT, `/tasks/${TASK}/relaunch`, {
    method: 'POST',
    body: JSON.stringify({
      message,
      date: o.date,
      time: o.time,
      await: o.await,
      interval: o.interval,
      repeatCount: o.repeatCount,
      repeatUntil: o.repeatUntil,
    }),
  })
  const scheduled = o.date != null || o.time != null || o.await != null
  let line = scheduled ? 'relaunch scheduled' : 'relaunching'
  if (o.interval != null) line += ` (repeating every ${o.interval}m)`
  console.log(line)
}

// Resolve a task id from a full id or any unambiguous prefix (so an agent can
// paste the short id `lander list` prints). Matches within the caller's project.
// `archived` resolves among archived tasks instead of active ones (for restore).
async function resolveId(idOrPrefix, { archived = false } = {}) {
  if (!idOrPrefix) die('a task id is required')
  const res = await call(PROJECT, `/tasks${archived ? '?archived=1' : ''}`, {
    method: 'GET',
  })
  // The list endpoint wraps the array as `{ tasks, usage }` (account usage rides
  // along with every poll); tolerate a bare array too in case the shape reverts.
  const tasks = Array.isArray(res) ? res : (res.tasks ?? [])
  const pool = archived ? tasks.filter((t) => t.archived) : tasks
  const matches = pool.filter((t) => t.id.startsWith(idOrPrefix))
  if (matches.length === 0) die(`no task matching ${idOrPrefix}`)
  if (matches.length > 1)
    die(`ambiguous task id ${idOrPrefix} (${matches.length} matches)`)
  return matches[0].id
}

// Parse a --since/--until value (anything Date can parse, same leniency as
// --date elsewhere) into epoch ms, dying with a clear message if it can't.
function parseDateArg(flag, value) {
  const ms = Date.parse(value)
  if (Number.isNaN(ms)) die(`${flag} expects a parseable date/time, got ${value}`)
  return ms
}

// `lander list [--status <s>] [--since <when>] [--until <when>] [--text <terms>] [--json]`
// — the project's tasks, newest first, as metadata only (id, title, status,
// createdAt, updatedAt) — never their conversation, in either output mode
// (see taskMetadata), even when --text matched inside one. --since/--until
// filter by createdAt, inclusive. --text searches title + message text,
// case-insensitively; repeat it for an AND, comma-delimit one occurrence for
// an OR (see matchesText).
async function listTasks(args) {
  let status
  let json = false
  let since
  let until
  const textGroups = []
  for (let i = 0; i < args.length; i++) {
    const a = args[i]
    if (a === '--status') status = args[++i]
    else if (a === '--json') json = true
    else if (a === '--since') since = parseDateArg('--since', args[++i])
    else if (a === '--until') until = parseDateArg('--until', args[++i])
    else if (a === '--text') {
      const terms = (args[++i] ?? '')
        .split(',')
        .map((s) => s.trim())
        .filter(Boolean)
      if (!terms.length) die('--text expects at least one non-empty term')
      textGroups.push(terms)
    } else die(`list: unexpected argument ${a}`)
  }
  const res = await call(PROJECT, '/tasks', { method: 'GET' })
  let tasks = Array.isArray(res) ? res : (res.tasks ?? [])
  if (status) tasks = tasks.filter((t) => t.status === status)
  if (since != null || until != null)
    tasks = tasks.filter((t) => inDateRange(t.createdAt, { since, until }))
  if (textGroups.length) tasks = tasks.filter((t) => matchesText(t, textGroups))
  const meta = tasks.map(taskMetadata)
  if (json) return void console.log(JSON.stringify(meta, null, 2))
  if (!meta.length) return void console.log('(no tasks)')
  for (const t of meta) {
    const sched = t.scheduledFor ? `  ⏰ ${t.scheduledFor}` : ''
    // A clockwise arrow beside the clock marks a task with a repeating relaunch
    // armed (see hasRepeat) — a `--interval` series still to fire.
    const repeats = t.repeats ? '  🔁' : ''
    console.log(
      `${t.id}  ${t.status.padEnd(7)}  ${t.createdAt}  ${t.updatedAt}  ${t.title}${sched}${repeats}`,
    )
  }
}

// `lander view <id> [--tools] [--json]` — one task's status and recent
// conversation. By default only the prose each side wrote is shown: the user's
// prompts and the assistant's text (including text it wrote between tool calls,
// which `m.text` — just the final block — would drop). --tools additionally
// interleaves the tool calls the assistant made.
async function viewTask(args) {
  let json = false
  let tools = false
  const pos = []
  for (const a of args) {
    if (a === '--json') json = true
    else if (a === '--tools') tools = true
    else pos.push(a)
  }
  if (!pos[0]) die('usage: lander view <id> [--tools]')
  const id = await resolveId(pos[0])
  const task = await call(PROJECT, `/tasks/${id}`, { method: 'GET' })
  if (json) return void console.log(JSON.stringify(task, null, 2))
  console.log(`${task.title}  [${task.status}]`)
  console.log(`id: ${task.id}`)
  if (task.scheduledFor) console.log(`scheduled: ${task.scheduledFor}`)
  console.log(`edits: ${task.allowEdits}  commits: ${task.allowCommits}`)
  const clip = (s) => (s.length > 600 ? `${s.slice(0, 600)}…` : s)
  for (const m of task.messages.slice(-6)) {
    const parts = []
    for (const s of m.steps ?? []) {
      if (s.kind === 'text') {
        if (s.text?.trim()) parts.push(clip(s.text))
      } else if (tools && s.kind === 'tool_use') {
        parts.push(`⚙ ${s.tool}${s.input ? `: ${clip(s.input)}` : ''}`)
      }
    }
    // User messages (and pre-steps records) carry no steps — fall back to text.
    const body = parts.length ? parts.join('\n\n') : clip(m.text ?? '')
    if (body.trim()) console.log(`\n${m.role}:\n${body}`)
  }
}

// `lander send <id> <message|-> [--date <when> | --time <minutes>] [--await <ids>]`
// — message another task in this project. Without a schedule the message is
// delivered now (queued behind any in-flight turn); --date/--time/--await defer
// delivery until that trigger fires (whichever comes first when several are set).
async function sendTask(args) {
  const o = {}
  const pos = []
  for (let i = 0; i < args.length; i++) {
    const a = args[i]
    if (a === '--date') o.date = args[++i]
    else if (a === '--time') o.time = Number(args[++i])
    else if (a === '--await') o.await = args[++i]
    else pos.push(a)
  }
  const target = pos.shift()
  if (!target) die('usage: lander send <id> <message>')
  let message = pos.shift()
  if (message === '-') message = await readStdin()
  if (!message?.trim()) die('usage: lander send <id> <message|->')
  validateSchedule(o)
  const awaitIds = await resolveAwait(o.await)
  const id = await resolveId(target)
  await call(PROJECT, `/tasks/${id}/messages`, {
    method: 'POST',
    body: JSON.stringify({ message, date: o.date, time: o.time, await: awaitIds }),
  })
  const verb =
    o.date != null || o.time != null || o.await != null ? 'scheduled' : 'sent'
  console.log(`${verb} → ${id.slice(0, 8)}`)
}

// `lander archive <id...> [--restore]` — move one or more tasks out of the list
// into the project's archived/ dir (or back, with --restore). Archiving needs a
// non-riding task; the server rejects a riding one. Resolves a full id or an
// unambiguous prefix — among active tasks to archive, among archived ones to
// restore.
async function archiveTask(args) {
  let restore = false
  const pos = []
  for (const a of args) {
    if (a === '--restore') restore = true
    else pos.push(a)
  }
  if (!pos[0]) die('usage: lander archive <id...> [--restore]')
  for (const arg of pos) {
    const id = await resolveId(arg, { archived: restore })
    await call(PROJECT, `/tasks/${id}/archive`, {
      method: 'POST',
      body: JSON.stringify({ archived: !restore }),
    })
    console.log(`${restore ? 'restored' : 'archived'} → ${id.slice(0, 8)}`)
  }
}

// `lander land [id...]` — with no id, land the current task: the terminal "I'm
// done" an agent calls when its work is finished. With ids, land those tasks
// instead, resolving a full id or an unambiguous prefix among active tasks. The
// server only lets a task land another it spawned (`lander launch`), so this
// winds down a task's own children, not arbitrary ones; landing yourself, or by
// id from the UI, stays unrestricted. A self-land stays silent (it's terminal —
// nothing to react to, see setStatus); landing other tasks prints a line per
// task, since the caller runs on and the outcome is worth confirming.
async function landTask(args) {
  if (!args.length) return setStatus('landed', { quiet: true })
  for (const arg of args) {
    const id = await resolveId(arg)
    await call(PROJECT, `/tasks/${id}`, {
      method: 'PATCH',
      body: JSON.stringify({ status: 'landed' }),
    })
    console.log(`landed → ${id.slice(0, 8)}`)
  }
}

// --- assist ----------------------------------------------------------------
// Run a one-shot `claude -p` session and return its reply. The prompt comes
// first; any further args are appended on their own line as the material to act
// on, so `lander assist "summarize:" "$(cat notes)"` sends the prompt then the
// notes. A non-zero exit from claude aborts. Shared by the `lander assist` CLI
// command and the `lander.assist()` flow API.
function runClaude(prompt, args) {
  const text = args.length ? `${prompt}\n${args.join('')}` : prompt
  // `--` so a prompt starting with a hyphen is taken as the positional prompt
  // rather than parsed as an option by claude's CLI.
  const r = spawnSync('claude', ['-p', '--', text], { encoding: 'utf8' })
  if (r.error) die(`assist: ${r.error.message}`)
  if (r.status !== 0)
    die(`assist: ${(r.stderr || '').trim() || `claude exited ${r.status}`}`)
  return r.stdout ?? ''
}

// `lander assist <prompt> [text …]` — print the assistant's reply to stdout.
async function assist(args) {
  const [prompt, ...rest] = args
  if (!prompt) die('usage: lander assist <prompt> [text …]')
  process.stdout.write(runClaude(prompt, rest))
}

// --- flows -----------------------------------------------------------------
// A flow is a JS script at data/<project>/flows/<name>.js exporting a default
// async function. `lander flow <name> [--key value …]` resolves the script's
// path from the server, imports it in this process, and calls it with a `lander`
// object — the same self-management surface as the CLI, but as awaitable methods
// (so `view` hands back a parsed task, not text to re-parse). The --key value
// pairs become the flow's `lander.inputs`.

// Run `command` under `sh` with the args as its positional params ($1, $2, …;
// "$@" for all) and return its stdout. A non-zero exit aborts the flow.
function runShell(command, args) {
  const r = spawnSync('sh', ['-c', command, 'sh', ...args], { encoding: 'utf8' })
  if (r.error) die(`shell: ${r.error.message}`)
  if (r.status !== 0)
    die(`shell: ${(r.stderr || '').trim() || `exited ${r.status}`}`)
  return r.stdout ?? ''
}

// The `lander` object handed to a flow script. Server-backed methods (launch,
// send, view, list, land, wedge, rest, relaunch) call the same API the CLI does;
// assist/shell run a local child; flow nests. Methods naming another task
// resolve a full id or unambiguous prefix, like the CLI.
function makeLander(inputs) {
  return {
    inputs,
    async launch(message, opts = {}) {
      if (!message?.trim()) die('lander.launch: a message is required')
      const o = {
        project: opts.project ?? PROJECT,
        message,
        title: opts.title,
        date: opts.date,
        time: opts.time,
        allowEdits: !!opts.edits,
        allowCommits: !!opts.commits,
      }
      validateSchedule(o)
      o.await = await resolveAwait(opts.await)
      const task = await call(o.project, '/tasks', {
        method: 'POST',
        body: JSON.stringify(o),
      })
      return task.id
    },
    async send(target, message, opts = {}) {
      if (!message?.trim()) die('lander.send: a message is required')
      validateSchedule(opts)
      const awaitIds = await resolveAwait(opts.await)
      const id = await resolveId(target)
      await call(PROJECT, `/tasks/${id}/messages`, {
        method: 'POST',
        body: JSON.stringify({
          message,
          date: opts.date,
          time: opts.time,
          await: awaitIds,
        }),
      })
      return id
    },
    async view(target) {
      const id = await resolveId(target)
      return call(PROJECT, `/tasks/${id}`, { method: 'GET' })
    },
    async list(opts = {}) {
      const tasks = await call(PROJECT, '/tasks', { method: 'GET' })
      return opts.status ? tasks.filter((t) => t.status === opts.status) : tasks
    },
    land: () => setStatus('landed', { quiet: true }),
    wedge: () => setStatus('wedged'),
    async rest(opts = {}) {
      // { clear: true } drops a pending wakeup instead of arming one; returns
      // whether any trigger was actually disarmed.
      if (opts.clear) {
        const res = await call(PROJECT, `/tasks/${TASK}/rest`, {
          method: 'POST',
          body: JSON.stringify({ clear: true }),
        })
        return res.cleared
      }
      const o = { date: opts.date, time: opts.time }
      validateSchedule(o)
      o.await = await resolveAwait(opts.await, { self: TASK })
      if (o.date == null && o.time == null && o.await == null)
        die('lander.rest: pass date, time, await, or clear')
      await call(PROJECT, `/tasks/${TASK}/rest`, {
        method: 'POST',
        body: JSON.stringify(o),
      })
    },
    async relaunch(message, opts = {}) {
      // { clear: true } drops a pending scheduled relaunch instead of arming one;
      // returns whether anything was disarmed.
      if (opts.clear) {
        const res = await call(PROJECT, `/tasks/${TASK}/relaunch`, {
          method: 'POST',
          body: JSON.stringify({ clear: true }),
        })
        return res.cleared
      }
      if (!message?.trim()) die('lander.relaunch: a message is required')
      // opts.interval (minutes) makes it repeat, bounded by opts.repeatCount
      // (total relaunches) or opts.repeatUntil (a date) — see validateRepeat.
      const o = {
        date: opts.date,
        time: opts.time,
        interval: opts.interval,
        repeatCount: opts.repeatCount,
        repeatUntil: opts.repeatUntil,
      }
      validateSchedule(o)
      validateRepeat(o)
      o.await = await resolveAwait(opts.await, { self: TASK })
      await call(PROJECT, `/tasks/${TASK}/relaunch`, {
        method: 'POST',
        body: JSON.stringify({
          message,
          date: o.date,
          time: o.time,
          await: o.await,
          interval: o.interval,
          repeatCount: o.repeatCount,
          repeatUntil: o.repeatUntil,
        }),
      })
    },
    assist: (prompt, ...args) => runClaude(prompt, args).trim(),
    shell: (command, ...args) => runShell(command, args).trim(),
    flow: (name, inputs = {}) => runFlowByName(name, inputs),
  }
}

async function runFlowByName(name, inputs) {
  const { path: file } = await call(
    PROJECT,
    `/flows/${encodeURIComponent(name)}`,
  )
  const mod = await import(pathToFileURL(file).href)
  if (typeof mod.default !== 'function')
    die(`flow "${name}" must export a default async function`)
  return mod.default(makeLander(inputs))
}

// `lander flow <name> [--key value …]` — the --key value pairs become inputs.
async function runFlow(args) {
  const name = args[0]
  if (!name) die('usage: lander flow <name> [--key value …]')
  const inputs = {}
  for (let i = 1; i < args.length; i++) {
    const a = args[i]
    if (!a.startsWith('--')) die(`flow: unexpected argument "${a}"`)
    inputs[a.slice(2)] = args[++i] ?? ''
  }
  await runFlowByName(name, inputs)
}

// --- bash-guard (PreToolUse hook) ------------------------------------------
// Wired in by the server as a PreToolUse hook on the Bash tool (see
// ClaudeAdapter hook settings). claude pipes the tool call as JSON on stdin;
// when the agent runs a Bash command with run_in_background set, we attach an
// advisory note explaining that the job won't outlive the turn — it's a child of
// this turn's claude, reaped when the turn ends, and lander never consumes its completion,
// so it can't wake the task ("you'll be notified when it completes" only holds
// in interactive mode, not lander's turn-based one). The note steers toward the
// mechanisms that do persist: `lander rest` to wait, `lander launch` for parallel
// agentic work.
//
// Crucially this is advisory only: we emit `additionalContext` and set NO
// permissionDecision, so the normal permission flow is untouched — run_in_background
// never grants access the same command wouldn't have in the foreground. Anything
// else passes straight through. A malformed payload never interferes.
async function bashGuard() {
  let input
  try {
    input = JSON.parse((await readStdin()) || '{}')
  } catch {
    return // malformed payload — don't interfere with the tool call
  }
  if (input.tool_name !== 'Bash' || input.tool_input?.run_in_background !== true)
    return
  const context =
    'Heads-up: this background job will not survive the turn. A backgrounded ' +
    "process is a child of this turn's claude; when the turn ends it is reaped, " +
    'and lander never consumes its completion, so it cannot wake the task — the ' +
    'job just leaks. Background it only for work you will consume within THIS ' +
    'turn. If you need to wait for something, end the turn and resume later with ' +
    '`lander rest --time <minutes>` / `--date <when>` / `--await <ids>`. For ' +
    'parallel agentic work, spawn a sibling task with `lander launch <message>`. ' +
    '(A turn-scoped co-process verb is planned for jobs that must outlive a turn.)'
  process.stdout.write(
    JSON.stringify({
      hookSpecificOutput: {
        hookEventName: 'PreToolUse',
        additionalContext: context,
      },
    }),
  )
}

// --- record-cwd (Stop hook) ------------------------------------------------
// Wired in by the server as a Stop hook (see ClaudeAdapter). At the end of
// each turn claude pipes the session state as JSON on stdin —
// { cwd, transcript_path, session_id, ... } — and we persist cwd and
// transcript_path onto the task. Without this, every turn re-spawns claude at
// the project root, so a directory the agent moved into mid-turn (most notably a
// git worktree it entered via EnterWorktree) is lost between turns; recording it
// lets the server resume the next turn there. Strictly best-effort: a Stop
// hook's stdout is not surfaced and nothing here may keep the turn from ending,
// so it swallows every error and never exits non-zero. It calls fetch directly
// rather than going through call() — call() die()s on a non-ok response, which
// would exit the hook non-zero for a transient server blip.
async function recordCwd() {
  try {
    const input = JSON.parse((await readStdin()) || '{}')
    const cwd = input.cwd
    if (!API || !PROJECT || !TASK || typeof cwd !== 'string' || !cwd) return
    const headers = { 'content-type': 'application/json', 'x-lander-task': TASK }
    headers['x-lander-project'] = PROJECT
    if (TOKEN) headers['x-lander-token'] = TOKEN
    await fetch(`${API}/api/${PROJECT}/tasks/${TASK}/cwd`, {
      method: 'POST',
      headers,
      body: JSON.stringify({ cwd, transcriptPath: input.transcript_path }),
    })
  } catch {
    // best-effort: never let a hook failure interfere with turn completion
  }
}

// --- record-worktree / clear-worktree (PostToolUse hooks) ------------------
// Wired in by the server as PostToolUse hooks on EnterWorktree / ExitWorktree
// (see ClaudeAdapter). claude pipes the tool call and its result as JSON on
// stdin. On EnterWorktree we forward the new worktree's root path (the result's
// `worktreePath`, falling back to the post-entry `cwd`) so the server tracks it
// and relaunches later turns with `--worktree <name>` — what makes the agent's
// own ExitWorktree work, since claude's worktree session doesn't survive
// `--resume`. On ExitWorktree we clear it, so the flag stops and turns return to
// the project root. Best-effort like record-cwd: swallow every error and never
// exit non-zero, so a hook blip can't wedge a turn or undo the tool that ran.
async function recordWorktree() {
  try {
    const input = JSON.parse((await readStdin()) || '{}')
    const worktreePath = input.tool_response?.worktreePath ?? input.cwd
    if (
      !API ||
      !PROJECT ||
      !TASK ||
      typeof worktreePath !== 'string' ||
      !worktreePath
    )
      return
    const headers = { 'content-type': 'application/json', 'x-lander-task': TASK }
    headers['x-lander-project'] = PROJECT
    if (TOKEN) headers['x-lander-token'] = TOKEN
    await fetch(`${API}/api/${PROJECT}/tasks/${TASK}/worktree`, {
      method: 'POST',
      headers,
      body: JSON.stringify({ worktreePath }),
    })
  } catch {
    // best-effort: never let a hook failure interfere with turn completion
  }
}

async function clearWorktree() {
  try {
    if (!API || !PROJECT || !TASK) return
    const headers = { 'x-lander-task': TASK, 'x-lander-project': PROJECT }
    if (TOKEN) headers['x-lander-token'] = TOKEN
    await fetch(`${API}/api/${PROJECT}/tasks/${TASK}/worktree`, {
      method: 'DELETE',
      headers,
    })
  } catch {
    // best-effort: never let a hook failure interfere with turn completion
  }
}

const [cmd, ...rest] = process.argv.slice(2)
const run = {
  land: () => landTask(rest),
  wedge: () => setStatus('wedged'),
  rest: () => restTask(rest),
  relaunch: () => relaunchTask(rest),
  launch: () => launchTask(rest),
  list: () => listTasks(rest),
  view: () => viewTask(rest),
  send: () => sendTask(rest),
  archive: () => archiveTask(rest),
  assist: () => assist(rest),
  flow: () => runFlow(rest),
  'bash-guard': () => bashGuard(),
  'record-cwd': () => recordCwd(),
  'record-worktree': () => recordWorktree(),
  'clear-worktree': () => clearWorktree(),
}[cmd]
if (!run)
  die(
    `unknown command: ${cmd ?? '(none)'} — try ` +
      'land [id...] | wedge | rest (--date|--time|--await|--clear) | ' +
      'relaunch <message> ' +
      '[--date|--time|--await|--interval|--repeat-count|--repeat-until|--clear] | ' +
      'launch <message> | list | view <id> [--tools] | send <id> <message> | ' +
      'archive <id...> [--restore] | assist <prompt> | flow <name>',
  )
run().catch((e) => die(e.message))
