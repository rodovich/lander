exports[`claude transcript regressions > a task checkout is the launch dir, snapshotted and named in the system prompt 1`] = `
{
  "done": {
    "exitCode": 0,
    "kind": "done",
    "stderr": "",
  },
  "launch": [
    {
      "args": [
        "--session-id",
        "minted-session-id",
        "--permission-mode",
        "acceptEdits",
        "--allowedTools",
        "Bash(lander:*)",
        "--add-dir",
        "/tmp",
        "--settings",
        "{"includeGitInstructions":false,"hooks":{"PreToolUse":[{"matcher":"Bash","hooks":[{"type":"command","command":"/repo/bin/lander bash-guard"}]}],"Stop":[{"hooks":[{"type":"command","command":"/repo/bin/lander record-cwd"}]}]}}",
        "--append-system-prompt",
        "Task prompt.

# Git
- Interactive flags (\`-i\`, e.g. \`git rebase -i\`, \`git add -i\`) are not supported in this environment.
- Use the \`gh\` CLI for GitHub operations (PRs, issues, API).
- Commit or push only when the user asks. If on the default branch, branch first.

This task works in a git worktree lander created for it at \`/repo/.worktrees/task-1\`, starting detached at whatever the project's main checkout (\`/repo\`) had checked out. Commit on a branch you create: lander removes this worktree when the task is landed or archived, and leaves branches alone.",
        "--output-format",
        "stream-json",
        "--verbose",
        "-p",
        "--",
        "do the thing

<task-context>
Task state as of this message — background context from lander, not the user's words. Re-sent only when it changes.

GIT-SNAPSHOT-STUB
</task-context>",
      ],
      "command": "claude",
      "cwd": "/repo/.worktrees/task-1",
      "envDelta": {
        "LANDER_PROJECT": "proj",
        "LANDER_RUN": "ride-1",
        "LANDER_TASK": "task-1",
      },
    },
  ],
  "task": {
    "createdAt": "2026-01-01T00:00:00.000Z",
    "flowState": {
      "sessionId": "minted-session-id",
      "turnContext": "<task-context>
Task state as of this message — background context from lander, not the user's words. Re-sent only when it changes.

GIT-SNAPSHOT-STUB
</task-context>",
    },
    "flowStateRev": 2,
    "hookFireSeq": 1,
    "id": "task-1",
    "items": [
      {
        "at": "2026-01-01T00:00:00.000Z",
        "groupId": "group:ride-1:0",
        "id": "itm-mjuohs00-0",
        "kind": "message",
        "rideId": "ride-1",
        "role": "flow",
        "text": "all done",
      },
    ],
    "pendingHooks": [
      {
        "at": "2026-01-01T00:00:00.000Z",
        "by": "agent",
        "id": "fire-1-mjuohs00",
        "outcome": "done",
        "rideId": "ride-1",
        "trigger": "ride-ended",
      },
    ],
    "rides": [
      {
        "endedAt": "2026-01-01T00:00:00.000Z",
        "id": "ride-1",
        "outcome": "done",
        "startedAt": "2026-01-01T00:00:00.000Z",
      },
    ],
    "shape": 2,
    "status": "riding",
    "title": "Parity task",
    "updatedAt": "2026-01-01T00:00:00.000Z",
  },
  "updates": [
    {
      "blockedIds": [],
      "committed": true,
      "drivingModel": "claude-opus-4-8",
      "finalText": "ok",
      "kind": "update",
      "rateLimitResetsAt": undefined,
      "steps": [
        {
          "createdAt": "2026-01-01T00:00:00.000Z",
